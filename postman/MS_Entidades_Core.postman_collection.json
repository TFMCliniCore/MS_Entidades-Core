    "name": "MS Entidades Core",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Colección Postman para probar el microservicio MS Entidades Core directamente (puerto 3001). Incluye autenticación de usuarios, gestión de fotos de perfil y CRUD de todas las entidades."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001/api/v1",
      "description": "URL base del microservicio en desarrollo local"
    }
  ],
  "item": [
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@clinicavet.test\",\n  \"contrasena\": \"Admin2026!\"\n}"
            },
            "url": "{{baseUrl}}/usuarios/login",
            "description": "Valida credenciales con bcrypt. Devuelve el objeto usuario sin contraseña. El API Gateway llama este endpoint internamente para luego emitir el JWT."
          }
        },
        {
          "name": "Listar usuarios",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/usuarios",
            "description": "Lista todos los usuarios con estado ACTIVO, incluyendo rol y sucursal."
          }
        },
        {
          "name": "Obtener usuario por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/usuarios/1",
            "description": "Devuelve un usuario específico (estado ACTIVO) con sus relaciones."
          }
        },
        {
          "name": "Crear usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombres\": \"Juliana Torres\",\n  \"email\": \"juliana.torres@clinicavet.test\",\n  \"celular\": \"3005557788\",\n  \"cargo\": \"Veterinaria\",\n  \"contrasena\": \"ClaveTemporal2026\",\n  \"sucursalId\": 1,\n  \"rolId\": 2\n}"
            },
            "url": "{{baseUrl}}/usuarios",
            "description": "Crea un usuario nuevo. La contraseña se hashea automáticamente con bcrypt (10 rondas) antes de guardarse en la base de datos."
          }
        },
        {
          "name": "Actualizar usuario (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombres\": \"Juliana Torres Mejía\",\n  \"celular\": \"3005557799\",\n  \"cargo\": \"Veterinario\",\n  \"rolId\": 2,\n  \"contrasena\": \"NuevaClave2026\"\n}"
            },
            "url": "{{baseUrl}}/usuarios/1",
            "description": "Actualiza campos del usuario. Si se incluye 'contrasena', se hashea con bcrypt antes de guardar. Si se omite, la contraseña no cambia."
          }
        },
        {
          "name": "Reemplazar usuario (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombres\": \"Juliana Torres\",\n  \"email\": \"juliana.torres@clinicavet.test\",\n  \"celular\": \"3005557788\",\n  \"cargo\": \"Veterinaria General\",\n  \"contrasena\": \"ClaveTemporal2026\",\n  \"sucursalId\": 2,\n  \"rolId\": 2\n}"
            },
            "url": "{{baseUrl}}/usuarios/1",
            "description": "Reemplaza el usuario completo. La contraseña se hashea con bcrypt."
          }
        },
        {
          "name": "Subir foto de perfil",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "foto",
                  "type": "file",
                  "src": "",
                  "description": "Imagen JPG, PNG o WebP. Tamaño máximo: 3 MB."
                }
              ]
            },
            "url": "{{baseUrl}}/usuarios/1/foto",
            "description": "Sube una foto de perfil para el usuario indicado. El archivo se guarda en uploads/usuarios/ y actualiza el campo 'foto' del usuario con la ruta relativa. Devuelve el usuario actualizado."
          }
        },
        {
          "name": "Obtener foto de perfil",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/usuarios/foto/usuario_1_1748970000000.jpg",
            "description": "Sirve el archivo de imagen almacenado. Reemplaza el nombre del archivo por el devuelto en el campo 'foto' del usuario."
          }
        },
        {
          "name": "Eliminar usuario",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/usuarios/1",
            "description": "Borrado lógico: cambia el estado del usuario a INACTIVO. No elimina el registro de la base de datos."
          }
        }
      ]
    },
